# Copy to .env and adjust. Never commit .env (NFR-4.2).
# On Windows, restrict access with:
#   icacls .env /inheritance:r /grant:r "%USERNAME%:R"

# --- Storage ---------------------------------------------------------------
# ALPHA500_DATA_DIR=C:/StockDashboard/data
# ALPHA500_EXPORT_DIR=C:/StockDashboard/exports

# --- Providers -------------------------------------------------------------
ALPHA500_BACKFILL_PROVIDER=yahoo
ALPHA500_INCREMENTAL_PROVIDER=nse
ALPHA500_HTTP_TIMEOUT_S=20
ALPHA500_YAHOO_RATE_PER_S=2.0
ALPHA500_NSE_RATE_PER_S=1.5

# --- Universe and eligibility ---------------------------------------------
ALPHA500_INDEX_NAME=NIFTY500
ALPHA500_MIN_HISTORY_DAYS=252
# Liquidity floor in rupees (FR-1.6). Default is Rs 5 crore.
ALPHA500_LIQUIDITY_FLOOR_INR=50000000

# --- Metric engine ---------------------------------------------------------
ALPHA500_MOMENTUM_LOOKBACK=90
ALPHA500_GAP_DISQUALIFIER_PCT=0.15
ALPHA500_REL_VOLUME_THRESHOLD=1.5
ALPHA500_BASE_WINDOW=15

# --- Composite weights (FR-6.8) -------------------------------------------
ALPHA500_W_MOMENTUM=0.30
ALPHA500_W_RET_12M_1M=0.20
ALPHA500_W_RS_RATING=0.20
ALPHA500_W_RANGE_POSITION=0.15
ALPHA500_W_ATR_PCT=0.10
ALPHA500_W_REL_VOLUME=0.05

# --- Risk (FR-10) ----------------------------------------------------------
ALPHA500_ATR_STOP_MULTIPLE=2.0
ALPHA500_RISK_PER_TRADE_PCT=0.0075
ALPHA500_MAX_POSITION_WEIGHT=0.10
ALPHA500_PORTFOLIO_HEAT_CEILING=0.06
ALPHA500_SECTOR_CONCENTRATION_LIMIT=0.25

# --- API -------------------------------------------------------------------
# Loopback only. Binding to 0.0.0.0 is not supported without an explicit
# configuration change: market-data licensing does not permit redistribution.
ALPHA500_API_HOST=127.0.0.1
ALPHA500_API_PORT=8000

# --- Kite Connect (unused; this build runs on free sources) ----------------
# ALPHA500_KITE_API_KEY=
# ALPHA500_KITE_API_SECRET=
